# cspell:words worktrees cocoindex codegraph

# default: ignore all files
*

## Allow Template files
!/templates
!/templates/**

# Allow README, LICENSE, CONTRIBUTING
!**/README*
!**/LICENSE*
!**/CONTRIBUTING*

# Allow .github directories
!.github/
!.github/**

# Allow other ignore
!*ignore

# Allow editorconfig
!**/.editorconfig

# Allow settings
!**/settings.json


## Root configs
!**/package.json
!**/pnpm-lock.yaml
!/renovate.json
!/lefthook.yml
!/dprint.jsonc
!/.shellspec
!/.mcp.json
!**/CHANGELOG.md
!**/Release-Note.md

## Project directories
# config files
!/configs/
!/configs/**
!/configs/**/*.json
!/configs/**/*.yml
!/configs/**/*.yaml
!/configs/**/*.toml
!/configs/**/*rc
!/configs/**/*.js
!/configs/**/*.mjs

# runners & scripts
!/runners
!/runners/**
!/runners/**/*.sh
!/scripts
!/scripts/**
!/scripts/**/*.sh
!/scripts/**/*.ts

## AI Agents
# claude code
!**/CLAUDE*.md

# allowlist details: .claude/.gitignore
!.claude/
!**/CLAUDE*.md
!.claude/agents/
!.claude/agents/**
!.claude/agents/**/*.md
!.claude/rules/
!.claude/rules/**
!.claude/rules/**/*.md


##  Editor
#   VSCode
!.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
!.vscode/cspell*
!.vscode/cspell*/**

## Projects speciified
!plugins/
!plugins/**

## ------------------------------------------------------------ ##
##  Re-exclude: secrets and generated files                      ##
##  Must stay last: these rules undo the broad allow rules above ##
## ------------------------------------------------------------ ##

# dependencies
**/node_modules/

# temporary directories, cache
**/temp/
**/tmp/
**/.cache/
**/.history/

# .env files
**/.env
**/.env.*

# logs, patches
*.log
*.diff
*.patch

# backup/swap/temp
*~
~*
$~*
*.tmp
*.swp

# allow all gitignore
!**/.gitignore
